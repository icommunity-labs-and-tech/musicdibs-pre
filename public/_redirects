/licenses               /terms          301
/hc/*                   /faq            301
/finalizar-compra       /pricing        301
/finalizar-compra/*     /pricing        301
/en/order-received      /               301
/en/order-received/*    /               301
/carrito                /pricing        301
/checkout               /pricing        301
/mi-cuenta              /dashboard      301
/mi-cuenta/*            /dashboard      301
/tienda                 /pricing        301
/producto/*             /pricing        301
/categoria-producto/*   /pricing        301
/wp-content/uploads/*   /distribution   301
/blog                   /news           301
